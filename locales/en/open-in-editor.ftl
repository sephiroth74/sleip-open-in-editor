# The plugin's texts in English: its commands' titles, by their names, and
# its notices.
command-open-in-editor-scrollback = Open Scrollback in Editor
command-open-in-editor-output = Open Output in Editor
# What an opening of nothing tells: no command that ended at the cell or
# before, or no text at all.
open-in-editor-no-command = No command that ended is here
open-in-editor-empty = There is no text to open
open-in-editor-not-written = The file was not written: { $error }
# A text longer than the file holds opens its last lines.
open-in-editor-cut = Only the last { $lines } lines open, as the rest did not fit
